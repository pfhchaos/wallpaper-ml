#version 450

// ============================================================
// add_inplace.comp — dst[i] += src[i]
// ============================================================
// Framework utility for summing gradient flows that meet at a
// shared activation (multi-depth models where one hidden state
// feeds multiple downstream paths). Caller passes dst and src as
// equal-length flat float buffers; result is written back into
// dst. Same shape as sgd_update — small primitive, no push-
// constant complexity beyond the element count.
// ============================================================

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Dst { float dst[]; };
layout(std430, binding = 1) readonly buffer Src { float src[]; };

layout(push_constant) uniform PushConstants {
    uint count;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    dst[i] += src[i];
}
